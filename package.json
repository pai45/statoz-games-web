{
  "name": "statoz-games-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-with-assets.mjs",
    "start": "next start",
    "lint": "eslint",
    "build:pages": "node scripts/build-github-pages.mjs",
    "deploy": "node scripts/deploy.mjs preview",
    "deploy:preview": "node scripts/deploy.mjs preview",
    "deploy:prod": "node scripts/deploy.mjs production",
    "deploy:setup": "node scripts/deploy.mjs setup",
    "deploy:check": "node scripts/deploy.mjs check",
    "sync:card-game": "node scripts/demo-no-upstream.mjs",
    "check:card-game": "node scripts/demo-no-upstream.mjs",
    "typography:sync": "node scripts/typography-library.mjs",
    "typography:check": "node scripts/typography-library.mjs --check",
    "prebuild": "npm run build:vibe-basketball && npm run build:games && npm run typography:check && npm run artwork:check && npm run match-discovery:check && npm run discovery:check && npm run backgrounds:check",
    "build:stadium-cricket": "node scripts/build-game-bundles.mjs --game=stadium-cricket",
    "test:stadium-cricket": "tsx --test tests/stadium-cricket.test.ts",
    "import:final-third": "node scripts/import-final-third.mjs",
    "build:final-third": "node scripts/build-game-bundles.mjs --game=final-third",
    "test:final-third": "tsx --test tests/final-third.test.ts",
    "prebuild:pages": "npm run build:vibe-basketball && npm run build:games && npm run typography:check && npm run artwork:check && npm run backgrounds:check",
    "artwork:sync": "node scripts/sync-game-discovery.mjs",
    "artwork:check": "node scripts/sync-game-discovery.mjs --check",
    "test:discovery": "node --test tests/game-discovery.test.mjs",
    "match-discovery:sync": "node scripts/match-discovery.mjs",
    "match-discovery:check": "node scripts/match-discovery.mjs --check",
    "test:match-editorial": "node --test tests/match-editorial.test.mjs",
    "discovery:sync": "node scripts/sync-discovery-library.mjs",
    "discovery:check": "node scripts/sync-discovery-library.mjs --check",
    "backgrounds:sync": "node scripts/sync-hub-backgrounds.mjs",
    "backgrounds:check": "node scripts/sync-hub-backgrounds.mjs --check",
    "test:backgrounds": "node --test tests/hub-backgrounds.test.mjs",
    "test:retro-presentation": "tsx --test tests/retro-presentation.test.ts && node tests/retro-presentation.browser.mjs",
    "test:retro-circuit": "tsx --test tests/retro-circuit.test.ts tests/retro-circuit-account.test.ts",
    "test:retro-hoops": "tsx --test tests/retro-hoops.test.ts tests/retro-hoops-account.test.ts tests/retro-hoops-protocol.test.ts tests/retro-hoops-catalog.test.ts tests/retro-hoops-animation.test.ts tests/retro-hoops-team-ai.test.ts tests/retro-hoops-view.test.ts tests/retro-hoops-three-points.test.ts tests/retro-hoops-gamelog.test.ts tests/retro-hoops-fidelity-v2.test.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test:demo": "tsx --test tests/demo-product.test.ts",
    "test:home": "tsx --test tests/home-catalog.test.ts && node tests/home-hub.browser.mjs",
    "typography:sync:all": "node scripts/demo-no-upstream.mjs",
    "prebuild:games": "node scripts/build-football-motion.mjs && node scripts/build-football-chance.mjs && node scripts/build-retro-football.mjs && node scripts/build-retro-innings.mjs",
    "build:games": "node scripts/build-game-bundles.mjs",
    "test:grand-prix": "tsx --test tests/grand-prix-rebuild.test.ts",
    "test:shootout": "tsx --test tests/penalty-shootout.test.ts tests/penalty-shootout-account.test.ts tests/penalty-shootout-animation.test.ts",
    "test:shootout:e2e": "playwright test --config playwright.shootout.config.ts",
    "build:vibe-basketball": "node scripts/build-vibe-basketball.mjs",
    "test:vibe-basketball": "tsx --test tests/vibe-basketball.test.ts && node --test tests/vibe-performance.test.mjs",
    "predev": "npm run build:vibe-basketball",
    "postinstall": "npm ci --prefix vendor/vibebasketball --omit=dev --no-audit --no-fund",
    "test:vibe-basketball:browser": "node scripts/verify-vibe-performance.mjs && node scripts/verify-vibe-mobile.mjs && node scripts/verify-vibe-basketball.mjs && node scripts/verify-vibe-extra.mjs",
    "test:device-assets": "node --test tests/device-assets.test.mjs",
    "test:device-assets:browser": "node tests/device-assets.browser.mjs",
    "test:mobile-viewport": "tsx --test tests/mobile-game-viewport.test.ts",
    "test:mobile-viewport:browser": "node tests/mobile-game-viewport.browser.mjs",
    "test:pitch-rush": "tsx --test tests/pitch-rush.test.ts && node --test tests/pitch-rush-gameplay.test.mjs",
    "test:pitch-duel": "tsx --test tests/pitch-duel-engine.test.ts tests/pitch-duel-cpu.test.ts tests/pitch-duel-career.test.ts",
    "test:pitch-duel:browser": "node tests/pitch-duel.browser.mjs",
    "build:pitch-rush": "node scripts/build-game-bundles.mjs --game=pitch-rush",
    "test:pitch-rush:browser": "node scripts/verify-pitch-rush.mjs",
    "test:pitch-rush:aim": "node scripts/verify-pitch-rush-aim.mjs"
  },
  "dependencies": {
    "lottie-react": "^3.1.1",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.186.1",
    "@dimforge/rapier3d-compat": "0.21.0",
    "howler": "2.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5",
    "vercel": "59.5.0",
    "@types/howler": "2.2.13",
    "@playwright/test": "1.64.1"
  }
}
