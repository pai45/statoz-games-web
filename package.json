{
  "name": "statoz-games-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:pages": "node scripts/build-github-pages.mjs",
    "deploy": "node scripts/deploy.mjs preview",
    "deploy:preview": "node scripts/deploy.mjs preview",
    "deploy:prod": "node scripts/deploy.mjs production",
    "deploy:setup": "node scripts/deploy.mjs setup",
    "deploy:check": "node scripts/deploy.mjs check",
    "sync:card-game": "node scripts/demo-no-upstream.mjs",
    "check:card-game": "node scripts/demo-no-upstream.mjs",
    "typography:sync": "node scripts/typography-library.mjs",
    "typography:check": "node scripts/typography-library.mjs --check",
    "prebuild": "npm run build:stadium-cricket && npm run typography:check && npm run artwork:check && npm run match-discovery:check && npm run discovery:check && npm run backgrounds:check",
    "build:stadium-cricket": "node scripts/build-game-bundles.mjs --game=stadium-cricket",
    "test:stadium-cricket": "tsx --test tests/stadium-cricket.test.ts",
    "prebuild:pages": "npm run build:games && npm run typography:check && npm run artwork:check && npm run backgrounds:check",
    "artwork:sync": "node scripts/sync-game-discovery.mjs",
    "artwork:check": "node scripts/sync-game-discovery.mjs --check",
    "test:discovery": "node --test tests/game-discovery.test.mjs",
    "match-discovery:sync": "node scripts/match-discovery.mjs",
    "match-discovery:check": "node scripts/match-discovery.mjs --check",
    "test:match-editorial": "node --test tests/match-editorial.test.mjs",
    "discovery:sync": "node scripts/sync-discovery-library.mjs",
    "discovery:check": "node scripts/sync-discovery-library.mjs --check",
    "backgrounds:sync": "node scripts/sync-hub-backgrounds.mjs",
    "backgrounds:check": "node scripts/sync-hub-backgrounds.mjs --check",
    "test:backgrounds": "node --test tests/hub-backgrounds.test.mjs",
    "test:retro-circuit": "tsx --test tests/retro-circuit.test.ts tests/retro-circuit-account.test.ts",
    "test:retro-hoops": "tsx --test tests/retro-hoops.test.ts tests/retro-hoops-account.test.ts tests/retro-hoops-protocol.test.ts tests/retro-hoops-catalog.test.ts tests/retro-hoops-animation.test.ts tests/retro-hoops-team-ai.test.ts tests/retro-hoops-view.test.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test:demo": "tsx --test tests/demo-product.test.ts",
    "typography:sync:all": "node scripts/demo-no-upstream.mjs",
    "prebuild:games": "node scripts/build-football-motion.mjs && node scripts/build-football-chance.mjs && node scripts/build-retro-football.mjs && node scripts/build-retro-innings.mjs",
    "build:games": "node scripts/build-game-bundles.mjs",
    "test:grand-prix": "tsx --test tests/grand-prix-rebuild.test.ts",
    "test:shootout": "tsx --test tests/penalty-shootout.test.ts tests/penalty-shootout-account.test.ts tests/penalty-shootout-animation.test.ts",
    "test:shootout:e2e": "playwright test --config playwright.shootout.config.ts"
  },
  "dependencies": {
    "lottie-react": "^3.1.1",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.186.1",
    "@dimforge/rapier3d-compat": "0.21.0",
    "howler": "2.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5",
    "vercel": "59.5.0",
    "@types/howler": "2.2.13",
    "@playwright/test": "1.64.1"
  }
}
